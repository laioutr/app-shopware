{
  "name": "@laioutr/app-shopware",
  "version": "0.15.2",
  "description": "Laioutr integration with Shopware 6",
  "repository": "github:laioutr/app-shopware",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "@screeny05/ts-money": "1.1.0",
    "@shopware/api-client": "1.2.1",
    "consola": "^3.4.2",
    "defu": "6.1.4",
    "slug": "^8.2.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@laioutr-app/ui": "^2.10.6",
    "@laioutr-core/canonical-types": "^0.27.4",
    "@laioutr-core/core-types": "^0.40.3",
    "@laioutr-core/devtools": "^0.40.3",
    "@laioutr-core/frontend-core": "^0.40.3",
    "@laioutr-core/kit": "^0.40.3",
    "@laioutr-core/orchestr": "^0.40.3",
    "@laioutr/eslint-config": "^1.9.5",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/image": "1.9.0",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@pinia/nuxt": "0.11.0",
    "@types/node": "latest",
    "@types/slug": "^5.0.7",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "nitropack": "^2.11.9",
    "nuxt": "3.16.2",
    "pinia": "3.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "unbuild": "3.6.1",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.27.4",
    "@laioutr-core/core-types": ">=0.40.3",
    "@laioutr-core/frontend-core": ">=0.40.3",
    "@laioutr-core/kit": ">=0.40.3",
    "@laioutr-core/orchestr": ">=0.40.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  }
}
