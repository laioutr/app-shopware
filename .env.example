# Copy to `playground/.env` to run the playground against a Shopware 6 instance. Nuxt reads the file
# from the root it was started with, which `pnpm dev` sets to `playground/` — a copy at the repo root
# is never loaded. It is gitignored either way.
#
# The store-API values below are Shopware's public frontends demo, published in
# https://github.com/shopware/frontends — they work as they stand, so a fresh clone has a shop to
# talk to. Replace them to point the playground somewhere else.

# Store API — https://<host>/store-api
SHOPWARE_DEMO_ENDPOINT=https://demo-frontends.shopware.store/store-api
SHOPWARE_DEMO_ACCESS_TOKEN=SWSCBHFSNTVMAWNZDNFKSHLAYW

# Admin API. Used for the media library and the system-entity lookups (currency,
# language, sales channel). Create an integration under Settings → System →
# Integrations and copy its ID and secret. The public demo grants no admin
# access, so these stay empty until you point the playground at your own shop.
SHOPWARE_DEMO_ADMIN_ENDPOINT=
SHOPWARE_DEMO_ADMIN_CLIENT_ID=
SHOPWARE_DEMO_ADMIN_CLIENT_SECRET=
